{
  "name": "ltstation-station",
  "productName": "LTStation Station",
  "version": "1.1.0",
  "description": "Logiciel Station (caisse, cartes, postes, rapports) — application de bureau avec serveur intégré",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.ltstation.station",
    "productName": "LTStation Station",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "setup.html",
      "loading.html"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LTStation Station",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      },
      {
        "from": "../backend/target/center-1.0.0.jar",
        "to": "server/center.jar"
      }
    ]
  }
}